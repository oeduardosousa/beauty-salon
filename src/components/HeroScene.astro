---
// Decorative 3D scene: a blooming flower with salon props floating at different depths.
// Pure CSS 3D (perspective + translateZ) so it needs no extra dependency; the outer
// wrapper is tilted by the pointer in motion.ts, which makes the depth layers parallax.
const outer = Array.from({ length: 10 }, (_, i) => i * 36);
const inner = Array.from({ length: 8 }, (_, i) => i * 45 + 22);
const core = Array.from({ length: 6 }, (_, i) => i * 60);
const mini = [
  { x: '8%', y: '14%', z: 40, s: 62, d: '0s' },
  { x: '78%', y: '62%', z: 90, s: 48, d: '-2s' },
  { x: '66%', y: '8%', z: -30, s: 38, d: '-4s' },
  { x: '14%', y: '70%', z: 110, s: 40, d: '-1s' },
];
const sparks = [
  { x: '24%', y: '30%', z: 150, d: '0s' },
  { x: '86%', y: '34%', z: 120, d: '-1.2s' },
  { x: '48%', y: '88%', z: 160, d: '-2.1s' },
  { x: '56%', y: '4%', z: 60, d: '-0.6s' },
  { x: '6%', y: '48%', z: 90, d: '-1.8s' },
];
---
<div class="hero-scene" role="img" aria-label="Cena ilustrativa em 3D: uma flor desabrochando com tesoura, espelho, batom e esmalte flutuando ao redor">
  <div class="scene-tilt" data-scene-tilt>
    <div class="scene-sway">
      <div class="scene-backdrop"></div>

      <div class="flower">
        <div class="ring ring--outer">
          {outer.map((a, i) => (
            <div class="petal petal--a" style={`--a:${a}deg;--t:${28 + (i % 2) * 6}deg;--i:${i}`}><i></i></div>
          ))}
        </div>
        <div class="ring ring--inner">
          {inner.map((a, i) => (
            <div class="petal petal--b" style={`--a:${a}deg;--t:${46 + (i % 2) * 6}deg;--i:${i}`}><i></i></div>
          ))}
        </div>
        <div class="ring ring--core">
          {core.map((a) => (
            <div class="petal petal--c" style={`--a:${a}deg;--t:62deg`}><i></i></div>
          ))}
          <div class="pistil"></div>
        </div>
      </div>

      {mini.map((m) => (
        <div class="prop prop--flower" style={`left:${m.x};top:${m.y};--z:${m.z}px;--s:${m.s}px;--d:${m.d}`}>
          <svg viewBox="-50 -50 100 100" aria-hidden="true">
            {[0, 72, 144, 216, 288].map((a) => <ellipse cx="0" cy="-22" rx="14" ry="22" transform={`rotate(${a})`} />)}
            <circle r="9" class="eye" />
          </svg>
        </div>
      ))}

      <!-- Scissors -->
      <div class="prop prop--tool" style="left:2%;top:34%;--z:130px;--s:120px;--d:-1s;--r:-24deg">
        <svg viewBox="0 0 120 120" aria-hidden="true">
          <g fill="none" stroke-linecap="round">
            <path d="M42 62 L100 14" stroke="#FFF5F3" stroke-width="7" />
            <path d="M42 62 L100 104" stroke="#E8DAF6" stroke-width="7" />
            <circle cx="28" cy="40" r="16" stroke="#F46FA1" stroke-width="7" />
            <circle cx="28" cy="84" r="16" stroke="#F46FA1" stroke-width="7" />
            <path d="M34 50 L48 62 M34 74 L48 62" stroke="#F46FA1" stroke-width="6" />
          </g>
          <circle cx="50" cy="62" r="4" fill="#2B0E26" />
        </svg>
      </div>

      <!-- Hand mirror -->
      <div class="prop prop--tool" style="left:70%;top:30%;--z:170px;--s:120px;--d:-3s;--r:16deg">
        <svg viewBox="0 0 120 160" aria-hidden="true">
          <rect x="52" y="86" width="16" height="64" rx="8" fill="#F46FA1" />
          <circle cx="60" cy="52" r="42" fill="#F46FA1" />
          <circle cx="60" cy="52" r="32" fill="#E8DAF6" />
          <path d="M38 40 C 46 28, 58 24, 70 28" stroke="#FFF5F3" stroke-width="6" stroke-linecap="round" fill="none" />
        </svg>
      </div>

      <!-- Lipstick -->
      <div class="prop prop--tool" style="left:56%;top:66%;--z:100px;--s:78px;--d:-2s;--r:12deg">
        <svg viewBox="0 0 60 130" aria-hidden="true">
          <path d="M18 56 L18 22 C 18 10, 42 8, 42 22 L42 56 Z" fill="#F46FA1" />
          <path d="M18 22 C 18 10, 42 8, 42 22 L 18 34 Z" fill="#FFF5F3" opacity=".35" />
          <rect x="14" y="54" width="32" height="14" fill="#2B0E26" />
          <rect x="10" y="68" width="40" height="56" rx="6" fill="#FFF5F3" />
          <rect x="10" y="68" width="40" height="10" fill="#E8DAF6" />
        </svg>
      </div>

      <!-- Nail polish -->
      <div class="prop prop--tool" style="left:20%;top:62%;--z:60px;--s:80px;--d:-4s;--r:-10deg">
        <svg viewBox="0 0 80 120" aria-hidden="true">
          <rect x="30" y="4" width="20" height="40" rx="6" fill="#2B0E26" />
          <rect x="26" y="40" width="28" height="10" fill="#FFF5F3" />
          <rect x="8" y="50" width="64" height="64" rx="18" fill="#F46FA1" />
          <path d="M20 62 C 18 78, 20 92, 26 102" stroke="#FFF5F3" stroke-width="5" stroke-linecap="round" fill="none" opacity=".7" />
        </svg>
      </div>

      <!-- Comb -->
      <div class="prop prop--tool" style="left:74%;top:78%;--z:30px;--s:110px;--d:-5s;--r:-18deg">
        <svg viewBox="0 0 120 50" aria-hidden="true">
          <rect x="2" y="2" width="116" height="18" rx="9" fill="#E8DAF6" />
          {Array.from({ length: 14 }, (_, i) => <rect x={6 + i * 8} y="18" width="3.5" height="28" rx="1.75" fill="#E8DAF6" />)}
        </svg>
      </div>

      {sparks.map((s) => (
        <div class="spark" style={`left:${s.x};top:${s.y};--z:${s.z}px;--d:${s.d}`}>
          <svg viewBox="-10 -10 20 20" aria-hidden="true"><path d="M0 -9 C 1 -3, 3 -1, 9 0 C 3 1, 1 3, 0 9 C -1 3, -3 1, -9 0 C -3 -1, -1 -3, 0 -9Z" /></svg>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .hero-scene {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-height: 52svh;
    perspective: 1100px;
    perspective-origin: 50% 40%;
    --petal: linear-gradient(180deg, #f46fa1 0%, #ffb3cf 100%);
  }
  .scene-tilt, .scene-sway { position: absolute; inset: 0; transform-style: preserve-3d; }
  .scene-sway { animation: sway 9s ease-in-out infinite; }
  .scene-backdrop {
    position: absolute;
    inset: 4% 8% 2%;
    border-radius: 50% 50% 28px 28px / 36% 36% 28px 28px;
    background: radial-gradient(circle at 50% 34%, #6b2c5e 0%, #431a3c 55%, #2b0e26 100%);
    box-shadow: 0 30px 80px rgb(43 14 38 / 0.35), inset 0 0 0 1px rgb(244 111 161 / 0.25);
    transform: translateZ(-120px) scale(1.2);
  }

  /* Flower: three petal rings stacked in depth, spinning slowly. */
  .flower {
    position: absolute;
    left: 50%;
    top: 46%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    animation: spin 28s linear infinite;
    --u: clamp(0.5px, 0.12vw + 0.38svh, 1.15px);
  }
  .ring { position: absolute; left: 0; top: 0; transform-style: preserve-3d; }
  .ring--outer { transform: translateZ(0); }
  .ring--inner { transform: translateZ(calc(14 * var(--u))); }
  .ring--core { transform: translateZ(calc(28 * var(--u))); }
  .petal {
    position: absolute;
    left: calc(-34 * var(--u));
    top: calc(-150 * var(--u));
    width: calc(68 * var(--u));
    height: calc(150 * var(--u));
    transform-origin: 50% 100%;
    transform: rotateZ(var(--a)) rotateX(var(--t));
    transform-style: preserve-3d;
  }
  .petal i {
    position: absolute;
    inset: 0;
    border-radius: 50% 50% 46% 46% / 78% 78% 22% 22%;
    background: var(--petal);
    box-shadow: inset 0 -18px 28px rgb(176 30 88 / 0.35), inset 0 0 0 1px rgb(255 245 243 / 0.28);
    transform-origin: 50% 100%;
    animation: breathe 5s ease-in-out calc(var(--i, 0) * -0.35s) infinite;
  }
  .petal--b { top: calc(-118 * var(--u)); height: calc(118 * var(--u)); }
  .petal--b i { background: linear-gradient(180deg, #ff93b9 0%, #ffd3e2 100%); }
  .petal--c { left: calc(-22 * var(--u)); top: calc(-72 * var(--u)); width: calc(44 * var(--u)); height: calc(72 * var(--u)); }
  .petal--c i { background: linear-gradient(180deg, #ffd3e2 0%, #fff5f3 100%); }
  .pistil {
    position: absolute;
    left: calc(-26 * var(--u));
    top: calc(-26 * var(--u));
    width: calc(52 * var(--u));
    height: calc(52 * var(--u));
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff5f3, #e8daf6 60%, #c9a9e8);
    transform: translateZ(calc(8 * var(--u)));
    box-shadow: 0 0 0 calc(6 * var(--u)) rgb(255 245 243 / 0.35);
  }

  /* Props float at their own depth, so tilting the scene shifts them against each other. */
  .prop, .spark {
    position: absolute;
    transform: translateZ(var(--z, 0px));
    transform-style: preserve-3d;
  }
  .prop > svg, .spark > svg {
    display: block;
    width: var(--s, 24px);
    height: auto;
    animation: float 6s ease-in-out var(--d, 0s) infinite;
    filter: drop-shadow(0 14px 18px rgb(43 14 38 / 0.35));
  }
  .prop--tool > svg { width: calc(var(--s) * 0.62); --rot: var(--r, 0deg); animation-name: float-rot; }
  .prop--tool { width: calc(var(--s) * 0.62); }
  .prop--flower > svg { fill: #f46fa1; stroke: rgb(255 245 243 / 0.5); stroke-width: 1.5; animation-name: float-spin; animation-duration: 12s; }
  .prop--flower .eye { fill: #fff5f3; stroke: none; }
  .spark { width: 22px; }
  .spark > svg { width: 22px; fill: #fff5f3; animation: twinkle 2.6s ease-in-out var(--d, 0s) infinite; filter: drop-shadow(0 0 6px rgb(255 245 243 / 0.9)); }

  @keyframes spin { to { transform: rotateZ(360deg); } }
  @keyframes sway {
    0%, 100% { transform: rotateY(-9deg) rotateX(6deg); }
    50% { transform: rotateY(9deg) rotateX(-3deg); }
  }
  @keyframes breathe {
    /* The individual `scale` property composes with the GSAP intro transform. */
    0%, 100% { scale: 1 1; }
    50% { scale: 0.96 1.07; }
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-14px); }
  }
  @keyframes float-rot {
    0%, 100% { transform: translateY(0) rotate(var(--rot)); }
    50% { transform: translateY(-16px) rotate(calc(var(--rot) + 6deg)); }
  }
  @keyframes float-spin {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-12px) rotate(180deg); }
  }
  @keyframes twinkle {
    0%, 100% { opacity: 0.25; transform: scale(0.6); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  /* Scrolled out of view (set from motion.ts): stop every endless animation. */
  .hero-scene.is-paused .scene-sway,
  .hero-scene.is-paused .flower,
  .hero-scene.is-paused .petal i,
  .hero-scene.is-paused .prop > svg,
  .hero-scene.is-paused .spark > svg { animation-play-state: paused; }

  /* Phones: the same scene, cheaper to paint. Blurred shadows and filters are re-rasterised
     every frame on a 3D-transformed tree, so swap them for flat equivalents and keep the
     rotation (the flower) while dropping the whole-scene sway. */
  @media (max-width: 767px) {
    .scene-sway { animation: none; transform: rotateY(-6deg) rotateX(4deg); }
    .scene-backdrop { box-shadow: inset 0 0 0 1px rgb(244 111 161 / 0.25); }
    .petal i { box-shadow: inset 0 0 0 1px rgb(255 245 243 / 0.28); }
    .prop > svg { filter: none; }
    .spark > svg { filter: none; }
  }

  @media (min-width: 1024px) {
    .hero-scene { max-height: none; height: 72svh; aspect-ratio: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scene-sway, .flower, .petal i, .prop > svg, .spark > svg { animation: none; }
    .scene-sway { transform: rotateY(-6deg) rotateX(4deg); }
    .spark > svg { opacity: 0.8; }
  }
</style>

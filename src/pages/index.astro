---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import Strands from '../components/Strands.astro';
import HeroPortrait from '../components/HeroPortrait.astro';
import { services, team } from '../data/salon';

// All services, prices, people and quotes below are invented placeholders.
// Each quote names the (invented) service it is about, so the testimonials read as specific, not generic.
const quotes: [string, string][] = [
  ['Saí com o cabelo que eu tinha na cabeça, só que melhor.', 'Corte Claquete'],
  ['Me explicaram cada passo antes de cortar. Dá confiança.', 'Take Um: corte e escova'],
  ['A cor ficou natural e a hidratação durou semanas.', 'Luzes em Cena'],
  ['Marquei em poucos toques e fui atendida na hora.', 'Raiz Perfeita'],
  ['Um corte com cara de cena final de filme.', 'Penteado de Estreia'],
];
---

<Base
  title="Cintila Studio: salão fictício de portfólio"
  description="Cintila Studio é um salão fictício criado como projeto de portfólio. Corte, cor e cuidado, com agendamento em quatro passos simulados."
  scenes
>
  <main id="conteudo">
    <!-- 1. Abertura -->
    <section class="hero" data-theme="paper" aria-labelledby="hero-title">
      <Strands />
      <div class="container">
        <div class="hero-copy">
          <p class="label eyebrow" data-intro>Salão fictício · projeto de portfólio</p>
          <h1 class="display" id="hero-title">
            <span class="line"><span class="line-inner">O seu</span></span>
            <span class="line"><span class="line-inner"><span class="serif">cabelo,</span></span></span>
            <span class="line"><span class="line-inner">em cena.</span></span>
          </h1>
          <p class="lead hero-note" data-intro>
            Corte, cor e cuidado no Cintila Studio. Escolha o serviço, a profissional e o horário em quatro passos.
          </p>
          <div class="hero-actions" data-intro>
            <a class="btn" href="/agendar" data-magnetic>Agendar</a>
            <a class="btn btn--secondary" href="#servicos" data-magnetic>Ver serviços<span class="arrow" aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="hero-media">
          <HeroPortrait />
        </div>
      </div>
    </section>

    <!-- 2. Manifesto -->
    <section class="chapter chapter--ink manifesto" id="manifesto" data-theme="ink" aria-label="Manifesto">
      <div class="container">
        <p id="manifesto-text">
          Cada corte é uma cena. Cada cor, um enquadramento. Aqui o seu cabelo é o <span class="hl">protagonista</span> e a nossa equipe cuida da edição.
        </p>
      </div>
    </section>

    <!-- 3. Serviços -->
    <section class="chapter chapter--ink" id="servicos" data-theme="ink" aria-labelledby="servicos-title" style="padding-top:0">
      <Strands />
      <div class="container">
        <div class="chapter-head">
          <div class="services-meta">
            <p class="label eyebrow">Serviços</p>
            <p class="label counter" id="services-counter" aria-hidden="true">Corte</p>
          </div>
          <h2 class="headline" id="servicos-title">Do corte ao <span class="serif">retoque</span></h2>
          <p class="lead muted">Nomes, durações e preços de exemplo, só para demonstrar o cardápio. Nada aqui é uma oferta real.</p>
        </div>
      </div>
      <div class="services-viewport" id="services-viewport">
        <div class="container">
          <ul class="track" id="services-track">
            {services.map((s) => (
              <li class="card" data-cat={s.cat}>
                <p class="label cat">{s.cat}</p>
                <h3>{s.name}</h3>
                <dl>
                  <div><dt class="label muted">Duração</dt><dd>{s.time}</dd></div>
                  <div><dt class="sr-only">Preço</dt><dd class="price">{s.price}<small>preço de exemplo</small></dd></div>
                </dl>
                <a class="link card-book" href={`/agendar?servico=${s.id}`}>Agendar este serviço<span class="sr-only"> ({s.name})</span></a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="container" style="margin-top:48px">
        <a class="btn" href="/agendar" data-magnetic>Agendar um serviço</a>
      </div>
    </section>

    <!-- 4. Equipe -->
    <section class="chapter" id="equipe" data-theme="paper" aria-labelledby="equipe-title">
      <div class="container">
        <div class="chapter-head">
          <p class="label eyebrow">Equipe</p>
          <h2 class="headline" id="equipe-title">Quem cuida do <span class="serif">seu</span> cabelo</h2>
          <p class="lead muted">Perfis fictícios, com especialidades e dias de atendimento de exemplo.</p>
        </div>
        <ul class="team">
          {team.map((p) => (
            <li class="person" data-speed={p.speed}>
              <Portrait who={p.id as 'marina' | 'caio' | 'livia'} alt={`retrato da equipe, ${p.name}`} />
              <h3 class="serif">{p.name}</h3>
              <ul>
                <li>{p.role}</li>
                <li class="muted">{p.days} (horário de exemplo)</li>
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. Antes e depois -->
    <section class="chapter chapter--ink" id="galeria" data-theme="ink" aria-labelledby="galeria-title">
      <div class="container compare" id="compare">
        <div class="compare-info">
          <div class="chapter-head" style="margin-bottom:0">
            <p class="label eyebrow">Antes e depois</p>
            <h2 class="headline" id="galeria-title">A virada de <span class="serif">cena</span></h2>
            <p class="lead muted">Imagens ilustrativas. Arraste a imagem ou use o controle para comparar; a rolagem também move a comparação.</p>
          </div>
          <label>
            <span class="label">Comparar antes e depois</span>
            <input type="range" min="0" max="100" value="50" id="compare-range" />
          </label>
        </div>
        <div class="compare-view">
          <div class="compare-stage" id="compare-stage">
            <div class="layer before"><Portrait who="antes" wide alt="antes: cabelo sem corte definido" caption={false} /></div>
            <div class="layer after"><Portrait who="depois" wide alt="depois: cabelo com corte e cor" caption={false} /></div>
            <div class="divider" aria-hidden="true"></div>
            <span class="tag-ph" style="position:absolute;left:8px;bottom:8px">Imagem ilustrativa</span>
          </div>
          <div class="compare-tags label" aria-hidden="true"><span>Antes</span><span>Depois</span></div>
        </div>
      </div>
    </section>

    <!-- 6. Opiniões -->
    <section class="chapter" id="opinioes" data-theme="paper" aria-labelledby="opinioes-title">
      <div class="container">
        <div class="chapter-head">
          <p class="label eyebrow">Opiniões</p>
          <h2 class="headline" id="opinioes-title">O que <span class="serif">dizem</span></h2>
          <p class="lead muted">Frases de exemplo escritas para o protótipo. Não são avaliações de clientes reais.</p>
        </div>
      </div>
      <div class="marquee" tabindex="0" role="region" aria-label="Opiniões de exemplo">
        <ul class="marquee-track">
          {quotes.map(([q, svc]) => (
            <li class="quote">
              <blockquote>{q}</blockquote>
              <p class="label muted">{svc} · opinião de exemplo</p>
            </li>
          ))}
          {quotes.map(([q, svc]) => (
            <li class="quote" aria-hidden="true">
              <blockquote>{q}</blockquote>
              <p class="label muted">{svc} · opinião de exemplo</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. Agendar -->
    <section class="band" data-theme="coral" aria-labelledby="agendar-title">
      <div class="container">
        <p class="label">Quatro passos: serviço, profissional, data e detalhes</p>
        <h2 id="agendar-title" style="margin:0">
          <a class="band-link" href="/agendar" data-magnetic>Agendar<span class="serif">.</span></a>
        </h2>
        <a class="btn" href="/agendar" data-magnetic>Começar a reserva</a>
      </div>
    </section>
  </main>

  <footer class="site-footer" id="contato" data-theme="ink">
    <div class="container">
      <div class="footer-grid">
        <div>
          <h2 class="label">Contato</h2>
          <p>Rua Exemplo, 000<br />Cidade Fictícia</p>
          <p class="muted">Endereço e telefone fictícios.</p>
          <p class="muted">Localização fictícia no mapa abaixo.</p>
        </div>
        <div>
          <h2 class="label">Horários</h2>
          <ul>
            <li>Terça a sábado, 9h às 19h</li>
            <li>Domingo e segunda: fechado</li>
          </ul>
          <p class="muted">Horários de exemplo.</p>
        </div>
        <div>
          <h2 class="label">Explore</h2>
          <ul>
            <li><a class="nav-link" href="#servicos">Serviços</a></li>
            <li><a class="nav-link" href="#equipe">Equipe</a></li>
            <li><a class="nav-link" href="#galeria">Galeria</a></li>
            <li><a class="nav-link" href="/agendar">Agendar</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-contact" data-contact>
        <h2 class="label">Fale com a gente</h2>
        <form class="form contact-form" novalidate>
          <div class="field">
            <label for="c-nome">Nome</label>
            <input id="c-nome" name="nome" type="text" autocomplete="name" required aria-describedby="c-e-nome" />
            <p class="field-error" id="c-e-nome"></p>
          </div>
          <div class="field">
            <label for="c-email">E-mail</label>
            <input id="c-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="c-e-email" />
            <p class="field-error" id="c-e-email"></p>
          </div>
          <div class="field">
            <label for="c-msg">Mensagem</label>
            <textarea id="c-msg" name="msg" rows="4" maxlength="500" required aria-describedby="c-e-msg"></textarea>
            <p class="field-error" id="c-e-msg"></p>
          </div>
          <div class="form-actions">
            <button class="btn" type="submit">Enviar mensagem</button>
          </div>
          <p class="contact-status" role="status" data-contact-status></p>
        </form>
        <p class="muted">Formulário de demonstração: nada é enviado e a mensagem não é guardada.</p>
      </div>
      <div class="footer-map">
        <div class="shop-map" id="shop-map" role="region" aria-label="Mapa com a localização fictícia do Cintila Studio" data-popup-title="Cintila Studio" data-popup-note="Endereço fictício, só para demonstração"></div>
      </div>
      <p class="footer-demo">
        Este site é uma demonstração de portfólio. O Cintila Studio não existe: nomes, preços, equipe, imagens e opiniões são inventados, e as reservas são simuladas.
      </p>
      <p class="footer-credit">Feito por <a href="https://github.com/oeduardosousa" target="_blank" rel="noopener">Eduardo Sousa</a></p>
      <p class="giant" aria-hidden="true">Cintila Studio</p>
    </div>
  </footer>
</Base>

<script>
  import '../scripts/contato.ts';
</script>

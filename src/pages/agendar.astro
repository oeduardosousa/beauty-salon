---
import Base from '../layouts/Base.astro';
import Booking from '../components/Booking.astro';
---

<Base
  title="Agendar · Cintila Studio"
  description="Reserve em quatro passos no Cintila Studio, salão fictício de portfólio: serviço, profissional, data e detalhes. A reserva é simulada."
>
  <main id="conteudo" class="app">
    <div class="container app-inner">
      <div class="app-head">
        <p class="label eyebrow">Agendar</p>
        <h1 class="headline">Reserve o seu <span class="serif">horário</span></h1>
        <p class="lead muted">Quatro passos: serviço, profissional, data e detalhes. É uma simulação: nada é enviado e a reserva fica guardada só nesta aba do navegador.</p>
      </div>
      <Booking />
    </div>
  </main>
</Base>

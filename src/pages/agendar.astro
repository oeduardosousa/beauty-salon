---
import Base from '../layouts/Base.astro';
---

<!-- The booking wizard lives on the home page (#reserva). This route only forwards old links there. -->
<Base
  title="Agendar · Cintila Studio"
  description="A reserva em quatro passos do Cintila Studio, salão fictício de portfólio, fica na página inicial."
>
  <main id="conteudo" style="min-height:100svh;display:grid;place-items:center;padding:96px var(--gutter)">
    <div style="display:grid;gap:24px;max-width:560px">
      <p class="label eyebrow">Agendar</p>
      <h1 class="headline">Levando você à <span class="serif">reserva</span></h1>
      <p><a class="btn" href="/#reserva">Ir para o agendamento</a></p>
    </div>
  </main>
</Base>

<script>
  import { navigate } from 'astro:transitions/client';
  document.addEventListener('astro:page-load', () => {
    if (location.pathname === '/agendar') navigate('/#reserva');
  });
</script>

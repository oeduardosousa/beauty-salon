---
import '../styles/global.css';
import '../styles/views.css';
import { ClientRouter } from 'astro:transitions';
import cormorantUrl from '@fontsource-variable/cormorant/files/cormorant-latin-wght-normal.woff2?url';
import jostUrl from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import RoleSwitch from '../components/RoleSwitch.astro';
import NavLinks from '../components/NavLinks.astro';

interface Props {
  title: string;
  description: string;
  scenes?: boolean;
  /** Which demo view the page belongs to. `entrada` is the "Sou cliente / Sou profissional" gateway. */
  role?: 'cliente' | 'profissional' | 'entrada';
}
const { title, description, scenes = false, role = 'cliente' } = Astro.props;

const navByRole = {
  cliente: [
    { href: '/#servicos', label: 'Serviços' },
    { href: '/#equipe', label: 'Equipe' },
    { href: '/#galeria', label: 'Galeria' },
    { href: '/#contato', label: 'Contato' },
  ],
  profissional: [
    { href: '/profissional#agenda', label: 'Agenda' },
    { href: '/profissional#reservas', label: 'Reservas' },
    { href: '/profissional#clientes', label: 'Clientes' },
    { href: '/profissional#disponibilidade', label: 'Disponibilidade' },
  ],
  entrada: [],
};
const nav = navByRole[role];
const home = role === 'profissional' ? '/profissional' : role === 'entrada' ? '/entrar' : '/';
const hasSwitch = role !== 'entrada';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFF5F3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={cormorantUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jostUrl} as="font" type="font/woff2" crossorigin />
    <ClientRouter />
    <script is:inline>
      (function () {
        // First visit to the home page in this tab: send people to the "Sou cliente / Sou profissional" gateway.
        // Deep links (/agendar, /conta, /profissional) open as asked, so a shared link never loses its destination.
        try {
          if (location.pathname === '/' && !sessionStorage.getItem('cintila-role')) {
            location.replace('/entrar');
            return;
          }
        } catch (e) {}
        var d = document.documentElement;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('js-motion');
        try {
          if (location.pathname === '/' && !sessionStorage.getItem('cintila-intro')) d.classList.add('has-loader');
        } catch (e) {}
        // Failsafe: if the motion script never runs on a scene page, show everything.
        setTimeout(function () {
          if (document.body && document.body.hasAttribute('data-scenes') && !d.classList.contains('motion-ready')) {
            d.classList.add('motion-failed');
            d.classList.remove('has-loader');
          }
        }, 4000);
      })();
    </script>
  </head>
  <body data-scenes={scenes ? '' : undefined} data-role={role}>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

    {scenes && (
      <div class="loader" aria-hidden="true">
        <div class="loader-inner">
          <div class="loader-count" id="loader-count">000</div>
          <div class="loader-blocks" id="loader-blocks">
            {Array.from({ length: 10 }).map(() => <i />)}
          </div>
        </div>
      </div>
    )}
    <div class="cursor" aria-hidden="true"></div>

    <header class="site-header" id="site-header" data-intro>
      <div class="container">
        <a class="wordmark" href={home} aria-label="Cintila Studio, página inicial">Cintila <span class="serif">Studio</span></a>
        {hasSwitch && (
          <div class="header-switch"><RoleSwitch role={role as 'cliente' | 'profissional'} /></div>
        )}
        {nav.length > 0 && (
          <nav class="nav-desktop label" aria-label="Principal">
            <NavLinks links={nav} role={role} variant="bar" />
          </nav>
        )}
        {nav.length > 0 && (
          <div class="header-end">
            {role === 'cliente' && <a class="btn header-cta" href="/agendar">Agendar</a>}
            <button class="menu-btn label" type="button" id="menu-open" aria-expanded="false" aria-controls="menu">Menu</button>
          </div>
        )}
      </div>
    </header>

    {nav.length > 0 && (
      <div class="menu-overlay" id="menu" role="dialog" aria-modal="true" aria-label="Menu">
        <button class="menu-close label" type="button" id="menu-close">Fechar</button>
        <div class="menu-body">
          <RoleSwitch role={role as 'cliente' | 'profissional'} />
          <nav aria-label="Menu principal">
            <NavLinks links={nav} role={role} variant="menu" />
          </nav>
        </div>
        <p class="label muted-on-ink" style="color:var(--muted-on-ink)">Salão fictício · projeto de portfólio</p>
      </div>
    )}

    <slot />

    {role === 'cliente' && (
      <div class="sticky-cta" id="sticky-cta"><a class="btn" href="/agendar">Agendar</a></div>
    )}

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
